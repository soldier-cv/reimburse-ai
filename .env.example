# ==============================================================================
# 个人应收与报销管理台 (reimburse-ai) 环境变量配置示例
# 复制为 .env 使用，或在容器环境变量中配置
# 注意：本文件仅包含键名与中文注释，禁止在此写入真实敏感信息
# ==============================================================================

# ------------------------------------------------------------------------------
# 服务运行基础配置
# ------------------------------------------------------------------------------
# 监听端口（容器内/本地启动端口，默认 8090；Docker Compose 映射到宿主机 8092）
PORT=8090

# 监听主机地址（默认 0.0.0.0）
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 存储与数据库路径（单机 SQLite 与本地附件存储）
# ------------------------------------------------------------------------------
# 数据目录根路径（默认指向项目根目录下的 data 目录；容器内挂载为 /app/data）
EXPENSE_DATA_DIR=

# SQLite 数据库文件绝对路径（留空则默认位于 ${EXPENSE_DATA_DIR}/expense.db）
EXPENSE_DB_PATH=

# 上传发票、截图及凭证文件的落盘目录（默认指向项目根目录下的 uploads 目录；容器内挂载为 /app/uploads）
EXPENSE_UPLOAD_DIR=

# ------------------------------------------------------------------------------
# 认证与初始账号配置
# ------------------------------------------------------------------------------
# JWT 会话签名密钥（留空时从持久化系统设置读取，首次启动若无则自动生成 32 字节安全随机密钥）
JWT_SECRET_KEY=

# 首次部署管理员用户名（可选；留空时首次访问 Web 界面会弹出初始化管理员向导）
ADMIN_USERNAME=

# 首次部署管理员密码（可选；必须与 ADMIN_USERNAME 同时配置才会在启动时自动创建）
ADMIN_PASSWORD=

# 是否开放用户自主注册（1/true/yes/on 开启；默认关闭，仅管理员在后台创建成员账号）
ALLOW_REGISTRATION=

# ------------------------------------------------------------------------------
# API 与跨域网络配置
# ------------------------------------------------------------------------------
# 是否开启 Swagger/Redoc API 文档接口（/docs, /redoc, /openapi.json；1/true/yes 开启；生产环境默认关闭）
ENABLE_API_DOCS=

# 允许跨域请求的 Origin 白名单（多个用英文逗号分隔，如 http://localhost:3000；同源反代部署保持为空）
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 采集与 AI 识别后台任务
# ------------------------------------------------------------------------------
# 发票与草稿后台 AI 识别任务的最大并发数（正整数，默认 4）
CAPTURE_CONCURRENCY=4

# 采集接口是否同步等待识别完成（1/true/yes 开启；仅用于单元测试或调试脚本，生产环境保持默认异步）
CAPTURE_SYNC=

# ------------------------------------------------------------------------------
# 导出与报表渲染
# ------------------------------------------------------------------------------
# PDF 财务报销包导出所使用的中文字体绝对路径（留空时自动探测系统中已安装的 Noto/WenQuanYi 字体）
CJK_FONT_PATH=
